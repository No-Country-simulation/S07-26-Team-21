# ==============================================================================
# BENCHMARK·DC Engine - Variables de Entorno de Ejemplo
# ==============================================================================
# Copie este archivo a '.env' y complete sus credenciales privadas:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración General del Proyecto
# ------------------------------------------------------------------------------
PROJECT_NAME="BENCHMARK·DC Engine"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# 2. Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=benchmark_password_2026
POSTGRES_DB=benchmark_engine

# ------------------------------------------------------------------------------
# 3. Configuración de Inteligencia Artificial (LLM)
# ------------------------------------------------------------------------------
# Proveedor activo: "gemini" | "claude" | "ollama"
LLM_PROVIDER=gemini

# Google Gemini (Configuración por defecto - Interactions API / Spec 2026)
# Obtener clave en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic Claude (Opcional - Producción)
CLAUDE_API_KEY=tu_api_key_de_claude_aqui
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Ollama Local (Opcional - 100% Offline)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. Resiliencia, Timeouts y Rate Limiting
# ------------------------------------------------------------------------------
# Tiempo límite máximo antes de activar degradación suave a fallbacks curados
LLM_TIMEOUT_SECONDS=25.0

# Máximo número de peticiones al LLM por ventana deslizante de 60 segundos
LLM_RATE_LIMIT_PER_MINUTE=30